{
  "name": "payment-system-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend del Sistema de Pagos Descentralizado con ICP",
  "scripts": {
    "setup": "npm i && dfx canister create payment_system_backend && dfx generate payment_system_backend && dfx deploy",
    "start": "vite --port 3000",
    "build": "tsc && vite build",
    "format": "prettier --write \"src/**/*.{json,js,jsx,ts,tsx,css,scss}\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@dfinity/agent": "^2.1.3",
    "@dfinity/candid": "^2.1.3",
    "@dfinity/principal": "^2.1.3",
    "@dfinity/identity": "^2.1.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.0.1",
    "dotenv": "^16.3.1",
    "typescript": "^5.1.3",
    "vite": "^4.3.9",
    "vite-plugin-environment": "^1.1.3",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "prettier": "^2.8.8"
  },
  "keywords": [
    "react",
    "typescript",
    "tailwind",
    "icp",
    "frontend"
  ],
  "author": "Tu Nombre",
  "license": "MIT"
}
