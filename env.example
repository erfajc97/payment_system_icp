# Internet Computer Configuration
# =============================

# Network Configuration
# --------------------
# Set to 'local' for local development, 'ic' for mainnet
DFX_NETWORK=local

# Internet Identity Configuration
# ------------------------------
# Production Internet Identity URL (used when DFX_NETWORK=ic)
INTERNET_IDENTITY_URL=https://identity.ic0.app

# Local Internet Identity URL (used when DFX_NETWORK=local)
# This is automatically set by dfx when running locally
# LOCAL_INTERNET_IDENTITY_URL=http://127.0.0.1:4943/?canisterId=rdmx6-jaaaa-aaaaa-aaadq-cai

# Frontend URLs
# -------------
# Main frontend URL (will be set by dfx deploy)
MAIN_FRONTEND_URL=http://localhost:4943/?canisterId=

# Landing page URL (will be set by dfx deploy)
LANDING_FRONTEND_URL=http://localhost:4943/?canisterId=

# Backend Canister IDs
# -------------------
# These will be automatically populated by dfx
PAYMENT_SYSTEM_BACKEND_CANISTER_ID=

# Frontend Canister IDs
# --------------------
# These will be automatically populated by dfx
PAYMENT_SYSTEM_FRONTEND_CANISTER_ID=
LANDING_FRONTEND_CANISTER_ID=

# Development Configuration
# ------------------------
# Enable HTTPS for local development (required for Internet Identity)
VITE_HTTPS_ENABLED=true

# Development server ports
VITE_MAIN_FRONTEND_PORT=3000
VITE_LANDING_FRONTEND_PORT=3001

# Environment
# -----------
NODE_ENV=development

# Optional: Custom configuration
# -----------------------------
# Uncomment and modify as needed

# Custom Internet Identity provider (if using a different one)
# CUSTOM_II_PROVIDER=https://your-custom-ii-provider.com

# Custom backend URL (if not using dfx)
# CUSTOM_BACKEND_URL=https://your-backend-url.com

# API Keys (if needed for external services)
# API_KEY=your-api-key-here

# Database Configuration (if using external database)
# DATABASE_URL=your-database-url-here

# Logging Configuration
# ---------------------
# Set to 'debug', 'info', 'warn', or 'error'
LOG_LEVEL=info

# Enable/disable debug mode
DEBUG=false 