{
  "canisters": {
    "payment_system_backend": {
      "main": "src/payment_system_backend/main.mo",
      "type": "motoko"
    },
    "payment_system_frontend": {
      "dependencies": ["payment_system_backend"],
      "source": ["src/payment_system_frontend/dist"],
      "type": "assets",
      "build": [
        "cd src/payment_system_frontend && npm install && npm run build"
      ]
    },
    "landing_frontend": {
      "dependencies": ["payment_system_backend"],
      "source": ["src/landing_frontend/dist"],
      "type": "assets",
      "build": ["cd src/landing_frontend && npm install && npm run build"]
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "output_env_file": ".env",
  "version": 1
}
